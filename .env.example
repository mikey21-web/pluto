# OpenRouter — Hermes-3 (priority 1, set this to use real LLM)
OPENROUTER_API_KEY=
HERMES_MODEL=nousresearch/hermes-3-llama-3.1-70b

# DeepSeek (priority 2, fallback if OpenRouter not set)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Pluto server
PLUTO_PORT=4000
PLUTO_DATA_DIR=./data

# Telemetry / learning toggles
PLUTO_LEARNING_ENABLED=true
PLUTO_TRACE_LEVEL=info